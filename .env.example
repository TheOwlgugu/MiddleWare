# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不要提交
# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iot_app
DB_PASSWORD=change_me
DB_NAME=sensor_data

# 服务端口（对外由 Nginx 反代，Node 只监听 127.0.0.1）
TCP_PORT=4000
WS_PORT=8081
# Unity 连接时带 ?token=，生产必须设置
WS_TOKEN=change_me
# WebSocket 只绑本机（由 SSH 隧道/Nginx 反代）
WS_HOST=127.0.0.1
# 认证失败限流：窗口内失败次数 / 窗口时长 / 封禁时长（毫秒）
AUTH_MAX_FAILS=10
AUTH_WINDOW_MS=300000
AUTH_BAN_MS=900000
HTTP_PORT=3000

# ChirpStack MQTT（只在本机）
# 0 = 不启动 MQTT（不开 ChirpStack 时用）
MQTT_ENABLED=1
MQTT_BROKER=mqtt://127.0.0.1:1883
MQTT_APP_ID=3c643783-29fa-4e4f-970d-202c5428d4b6

# 下行队列有效期（秒）
DOWNLINK_TTL_SEC=120

# 日志级别与保留天数
LOG_LEVEL=info
LOG_KEEP_DAYS=7
